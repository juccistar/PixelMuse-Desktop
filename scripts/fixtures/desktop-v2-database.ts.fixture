import Database from 'better-sqlite3';
import { BackendError } from './validation.js';

/** SQLite 仅由 Backend owner 打开，迁移与版本号一起提交。 */
export function openDatabase(path: string): Database.Database {
  const db = new Database(path);
  try {
    db.pragma('journal_mode = WAL');
    db.pragma('busy_timeout = 5000');
    db.pragma('foreign_keys = ON');
    const version = db.pragma('user_version', { simple: true });
    if (typeof version !== 'number' || version < 0 || version > 2) throw new BackendError('UNSUPPORTED_DATABASE', '数据版本不受支持。');
    if (version === 0) {
      // DDL 和版本标记必须一起提交，避免启动中断留下半成品 schema。
      db.transaction(() => {
        db.exec(`
          CREATE TABLE projects (
            id TEXT PRIMARY KEY, name TEXT NOT NULL, description TEXT NOT NULL,
            createdAt TEXT NOT NULL, updatedAt TEXT NOT NULL
          );
          CREATE TABLE assets (
            id TEXT PRIMARY KEY, projectId TEXT NOT NULL REFERENCES projects(id), name TEXT NOT NULL,
            mimeType TEXT NOT NULL, size INTEGER NOT NULL, width INTEGER NOT NULL, height INTEGER NOT NULL,
            createdAt TEXT NOT NULL, file TEXT NOT NULL UNIQUE, sha256 TEXT NOT NULL
          );
          CREATE INDEX assets_project ON assets(projectId, id);
          CREATE TABLE providers (
            id TEXT PRIMARY KEY, name TEXT NOT NULL, protocol TEXT NOT NULL, baseUrl TEXT NOT NULL,
            model TEXT NOT NULL, encryptedKey TEXT NOT NULL, updatedAt TEXT NOT NULL
          );
          CREATE TABLE jobs (
            id TEXT PRIMARY KEY, projectId TEXT NOT NULL REFERENCES projects(id), kind TEXT NOT NULL CHECK(kind = 'EXPORT'),
            status TEXT NOT NULL CHECK(status IN ('QUEUED','RUNNING','SUCCEEDED','FAILED','CANCELLED')),
            progress REAL NOT NULL DEFAULT 0, cancelRequested INTEGER NOT NULL DEFAULT 0,
            error TEXT, createdAt TEXT NOT NULL, updatedAt TEXT NOT NULL, resultName TEXT,
            fingerprint TEXT NOT NULL, snapshot TEXT NOT NULL
          );
          CREATE INDEX jobs_queue ON jobs(status, createdAt, id);
          CREATE INDEX jobs_project ON jobs(projectId, createdAt);
          CREATE UNIQUE INDEX jobs_dedupe ON jobs(fingerprint) WHERE status IN ('QUEUED','RUNNING','SUCCEEDED');
          PRAGMA user_version = 1;
        `);
      })();
    }
    if (version < 2) {
      db.transaction(() => {
        db.exec(`
          ALTER TABLE assets ADD COLUMN role TEXT NOT NULL DEFAULT 'STYLE_REFERENCE';
          ALTER TABLE providers ADD COLUMN reasoningProtocol TEXT NOT NULL DEFAULT 'openai';
          ALTER TABLE providers ADD COLUMN supportsVision INTEGER NOT NULL DEFAULT 0;
          ALTER TABLE providers ADD COLUMN supportsThinking INTEGER NOT NULL DEFAULT 0;
          ALTER TABLE providers ADD COLUMN supportsStructuredOutput INTEGER NOT NULL DEFAULT 0;
          CREATE TABLE jobs_v2 (
            id TEXT PRIMARY KEY, projectId TEXT NOT NULL REFERENCES projects(id),
            kind TEXT NOT NULL CHECK(kind IN ('EXPORT','PLAN','GENERATE','SEGMENT','LAYER','PATTERN','SUITE','PI_AGENT')),
            status TEXT NOT NULL CHECK(status IN ('QUEUED','RUNNING','SUCCEEDED','FAILED','CANCELLED','UNKNOWN')),
            progress REAL NOT NULL DEFAULT 0, cancelRequested INTEGER NOT NULL DEFAULT 0,
            error TEXT, createdAt TEXT NOT NULL, updatedAt TEXT NOT NULL, resultName TEXT,
            fingerprint TEXT NOT NULL, snapshot TEXT NOT NULL,
            requestState TEXT NOT NULL DEFAULT 'NOT_SENT' CHECK(requestState IN ('NOT_SENT','IN_FLIGHT','COMPLETED','UNKNOWN'))
          );
          INSERT INTO jobs_v2 (id,projectId,kind,status,progress,cancelRequested,error,createdAt,updatedAt,resultName,fingerprint,snapshot)
            SELECT id,projectId,kind,status,progress,cancelRequested,error,createdAt,updatedAt,resultName,fingerprint,snapshot FROM jobs;
          DROP TABLE jobs;
          ALTER TABLE jobs_v2 RENAME TO jobs;
          CREATE INDEX jobs_queue ON jobs(status,createdAt,id);
          CREATE INDEX jobs_project ON jobs(projectId,createdAt);
          CREATE UNIQUE INDEX jobs_dedupe ON jobs(fingerprint) WHERE status IN ('QUEUED','RUNNING','SUCCEEDED','UNKNOWN');
          CREATE TABLE project_business (projectId TEXT PRIMARY KEY REFERENCES projects(id), settings TEXT NOT NULL);
          CREATE TABLE storyboards (
            id TEXT PRIMARY KEY, projectId TEXT NOT NULL REFERENCES projects(id), jobId TEXT NOT NULL UNIQUE REFERENCES jobs(id),
            version INTEGER NOT NULL, confirmed INTEGER NOT NULL DEFAULT 0, data TEXT NOT NULL,
            UNIQUE(projectId,version)
          );
          CREATE TABLE job_results (jobId TEXT PRIMARY KEY REFERENCES jobs(id), data TEXT NOT NULL);
          PRAGMA user_version = 2;
        `);
      })();
    }
    return db;
  } catch (error) {
    db.close();
    throw error;
  }
}
